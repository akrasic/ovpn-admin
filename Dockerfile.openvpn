FROM golang:1.27.3-trixie AS builder
COPY . /app
ARG TARGETARCH
RUN cd /app && env CGO_ENABLED=1 GOOS=linux GOARCH=${TARGETARCH} go build -tags netgo -ldflags '-linkmode external -extldflags -static -s -w' -o openvpn-user ./cmd/openvpn-user

FROM alpine:3.24
ARG TARGETARCH
COPY --from=builder /app/openvpn-user /usr/local/bin/openvpn-user
RUN apk upgrade --no-cache && \
    apk add --no-cache ca-certificates bash openvpn easy-rsa iptables && \
    ln -s /usr/share/easy-rsa/easyrsa /usr/local/bin && \
    rm -rf /tmp/* /var/tmp/* /var/cache/apk/* /var/cache/distfiles/*
COPY setup/ /etc/openvpn/setup
RUN chmod +x /etc/openvpn/setup/configure.sh
